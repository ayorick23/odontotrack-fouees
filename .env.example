# Copia este archivo a ".env" (en la misma carpeta) y ajusta los
# valores si hace falta. El archivo ".env" real NUNCA se sube al
# repositorio (está en .gitignore) porque puede llegar a tener
# credenciales reales en otros entornos.
#
# Backend y frontend leen este mismo archivo:
#   - Django lo lee con python-decouple (backend/config/settings.py)
#   - Vite lo lee gracias a "envDir" en frontend/vite.config.ts

# --- Django ---
DJANGO_SECRET_KEY=django-insecure-change-me-in-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (PostgreSQL) ---
# DB_HOST=localhost sirve para correr el backend fuera de Docker.
# Dentro de docker-compose, el backend usa automáticamente DB_HOST=db
# (ver docker-compose.yml), así que no necesitas cambiar esto.
DB_NAME=odontotrack
DB_USER=odontotrack
DB_PASSWORD=odontotrack
DB_HOST=localhost
DB_PORT=5432

# --- CORS (para que el frontend pueda llamar a la API en desarrollo) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---
# Debe empezar con VITE_ para que Vite la exponga en el navegador.
VITE_API_URL=http://localhost:8000/api
